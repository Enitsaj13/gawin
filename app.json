{
  "expo": {
    "name": "Gawin",
    "slug": "gawin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/gawin-icon.png",
    "scheme": "gawin",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.jastineapps.gawin",
      "icon": "./assets/images/gawin-icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jastineapps.gawin",
      "adaptiveIcon": {
        "backgroundColor": "#FBFBF9",
        "foregroundImage": "./assets/images/gawin-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBFBF9",
          "image": "./assets/images/todo-splash.png",
          "imageWidth": 128,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f0c083c9-9efe-4813-baba-7d5d59b7768e"
      }
    },
    "owner": "jastine-apps"
  }
}
