    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3",
    "workbox-cli": "^7.4.1"
  },
  "scripts": {
    "start": "expo start",
    "start:development": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "ios:device:release": "expo run:ios --configuration Release --device",
    "web": "expo start --web",
    "build:web": "expo export -p web && workbox generateSW workbox-config.cjs",
    "serve:web": "expo serve",
    "lint": "expo lint",
    "build:development": "npx eas-cli@latest build --profile development",
    "build:development:ios": "npx eas-cli@latest build --platform ios --profile development",
    "build:preview": "npx eas-cli@latest build --profile preview",
    "build:preview:ios": "npx eas-cli@latest build --platform ios --profile preview"
  },
  "private": true
}
